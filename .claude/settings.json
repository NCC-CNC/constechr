{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git merge*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(git rm --cached *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git check-ignore *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh api *)",
      "Bash(cat MEMORY.md)",
      "Bash(Rscript -e \"devtools::*)",
      "Bash(Rscript -e \"lintr::*)",
      "Bash(Rscript -e \"covr::*)",
      "Bash(Rscript -e \"styler::*)",
      "PowerShell(Rscript -e \"devtools::*)",
      "PowerShell(Rscript -e \"lintr::*)",
      "PowerShell(Rscript -e \"covr::*)",
      "PowerShell(Rscript -e \"styler::*)"
    ],
    "ask": [
      "Bash(gh pr create*--base main*)",
      "Bash(gh pr create*--base=main*)",
      "Bash(gh pr create*-B main*)",
      "Bash(gh pr edit*--base main*)",
      "Bash(gh pr edit*--base=main*)",
      "Bash(gh pr edit*-B main*)",
      "Bash(gh pr merge*)",
      "Bash(git push*main*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  }
}
